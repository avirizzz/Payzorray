PORT=3000

# Comma-separated list of allowed CORS origins for the two frontend apps
# (frontend-storefront, frontend-ai-buyer). Defaults to allow-all if unset --
# fine for local dev, set explicitly once frontends are deployed, e.g.:
# ALLOWED_ORIGINS=https://storefront.vercel.app,https://ai-buyer.vercel.app
ALLOWED_ORIGINS=

# Supabase Credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# LLM Provider
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Web search (AI Buyer's search_web tool -- real products outside our
# catalog, shown honestly as not purchasable here). Get a key at
# https://tavily.com -- free tier is enough for dev/demo use.
TAVILY_API_KEY=your_tavily_api_key
